{
  "name": "ikomida-website",
  "version": "1.0.1",
  "private": true,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "sirv": "rollup -c -w",
    "watch:prod": "rollup -c -w --environment ENV:production",
    "watch:hmlg": "rollup -c -w --environment ENV:homologation",
    "watch:dev": "rollup -c -w --environment ENV:development",
    "dev": "rollup -c --environment ENV:development",
    "hmlg": "rollup -c --environment ENV:homologation",
    "prod": "rollup -c --environment ENV:production",
    "start": "sirv public --no-clear --single --host",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./lib ./docs",
    "glogin": "artifactregistry-auth",
    "prepublishOnly": "yarn lint",
    "preversion": "yarn lint",
    "version": "yarn format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "mocha",
    "local:watch:dev": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn svelte-check && yarn watch:dev",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@capacitor/cli": "^4.3.0",
    "@capacitor/core": "^4.3.0",
    "@rollup/plugin-commonjs": "^23.0.0",
    "@rollup/plugin-json": "^5.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.0",
    "@rollup/plugin-typescript": "^9.0.1",
    "@tsconfig/svelte": "^3.0.0",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "http-server": "^14.1.1",
    "javascript-obfuscator": "^4.0.0",
    "jsdoc": "^3.6.11",
    "linkify-it": "^4.0.1",
    "node-sass": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.18",
    "postcss-load-config": "^4.0.1",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^3.2.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.52.0",
    "svelte-as-markup-preprocessor": "^0.3.0",
    "svelte-check": "^2.9.2",
    "svelte-fa": "^3.0.3",
    "svelte-preprocess": "^4.10.7",
    "svelte-preprocess-cssmodules": "^2.2.3",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.16",
    "typescript": "^4.8.4",
    "typescript-svelte-plugin": "^0.3.10"
  },
  "dependencies": {
    "@capacitor/preferences": "^4.0.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@ikomida/shared-frontend": "^1.3.21",
    "credit-card-type": "^9.1.0",
    "firebase": "^9.12.1",
    "svelte-carousel": "^1.0.20",
    "svelte-fa": "^3.0.3",
    "svelte-navigator": "^3.2.2"
  }
}
